  document.getElementById('log-modal').classList.remove('open');
  openAnalysisModal();
});
document.getElementById('analysis-close').addEventListener('click', function(){
  document.getElementById('analysis-modal').classList.remove('open');
  document.body.style.overflow = '';
});
document.getElementById('analysis-modal').addEventListener('click', function(e){
  if(e.target===this){ this.classList.remove('open'); document.body.style.overflow=''; }
});
document.getElementById('btn-analysis-run').addEventListener('click', runAnalysis);

renderChapters();
