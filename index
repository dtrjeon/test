function renderChapters(){
  const grid = document.getElementById('chapters-grid');
  grid.innerHTML = CHAPTERS.map(ch =>
    `<button class="chapter-btn" id="ch-btn-${ch.id}" data-id="${ch.id}">
       <div class="ch-num">${ch.num}</div>
       <div class="ch-title">${ch.title}</div>
       <div class="ch-order" id="ch-order-${ch.id}"></div>
     </button>`
  ).join('');
  grid.querySelectorAll('.chapter-btn').forEach(btn => {
    btn.addEventListener('click', function(){ toggleChapter(parseInt(this.dataset.id)); });
  });
}
document.getElementById('mode-single').addEventListener('click', () => setMode('single'));
document.getElementById('mode-multi').addEventListener('click',  () => setMode('multi'));
function setMode(m){
  mode = m; selected = [];
  document.getElementById('mode-single').classList.toggle('active', m==='single');
  document.getElementById('mode-multi').classList.toggle('active',  m==='multi');
  updateChapterUI();
}
function toggleChapter(id){
  if(mode==='single'){ selected = selected[0]===id ? [] : [id]; }
  else{ const i=selected.indexOf(id); if(i===-1) selected.push(id); else selected.splice(i,1); }
  updateChapterUI();
}
function updateChapterUI(){
  CHAPTERS.forEach(ch => {
    const btn = document.getElementById('ch-btn-'+ch.id);
    const ord = document.getElementById('ch-order-'+ch.id);
    const idx = selected.indexOf(ch.id);
    btn.classList.toggle('selected', idx !== -1);
    ord.textContent = (idx !== -1 && mode === 'multi') ? (idx+1) : '';
  });
  const box = document.getElementById('preview-box');
  if(selected.length === 0){
    box.innerHTML = '<div class="preview-empty">챕터를 선택하면 원본이 자동으로 설정됩니다</div>';
    document.getElementById('original').value = ''; return;
  }
  const combined = selected.map(id => CHAPTERS.find(c=>c.id===id).text).join(' ');
  const chips = selected.map(id => {
    const c = CHAPTERS.find(x=>x.id===id);
    return `<span class="preview-chip">${c.num} ${c.title}</span>`;
  }).join('');
  box.innerHTML = `<div class="preview-chips">${chips}</div><div class="preview-snip">${combined.slice(0,80)}…</div>`;
  document.getElementById('original').value = combined;
}

