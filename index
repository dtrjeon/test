function buildPreviewHTML(d){
  const now = new Date();
  const dateStr = now.getFullYear()+'.'
    +(now.getMonth()+1).toString().padStart(2,'0')+'.'+now.getDate().toString().padStart(2,'0')
    +' '+now.getHours().toString().padStart(2,'0')+':'+now.getMinutes().toString().padStart(2,'0');

  // ── 문장별로 ops를 분리 ──
  // ops 를 wordSentIdx 기준으로 문장 그룹으로 묶기
  const sentGroups = []; // [{sentIdx, origWords:[], recWords:[], ops:[]}]
  let curSent = -1;
  let origPtr2 = 0;

  d.ops.forEach(op => {
    let si = curSent;
    if(op.t !== 'extra'){
      si = d.wordSentIdx[origPtr2] !== undefined ? d.wordSentIdx[origPtr2] : curSent;
      origPtr2++;
    }
    // 새 문장 시작 또는 아직 그룹이 없을 때
    if(si !== curSent || sentGroups.length === 0){
      // extra 이면서 아직 그룹이 없는 경우 — 첫 번째 그룹에 포함
      if(op.t === 'extra' && sentGroups.length === 0){
        sentGroups.push({si: 0, ops:[]});
      } else if(si !== curSent) {
        curSent = si;
        sentGroups.push({si, ops:[]});
      }
    }
    if(sentGroups.length === 0) sentGroups.push({si:0, ops:[]});
    sentGroups[sentGroups.length-1].ops.push(op);
  });

  // ── 문장별 HTML 생성 ──
  function wordHTML(op, side){
    if(op.t==='ok'){
      return `<span class="pw pw-ok">${esc(side==='l'?op.aw:op.bw)}</span>`;
    } else if(op.t==='miss'){
      return side==='l'
        ? `<span class="pw pw-miss">${esc(op.aw)}</span>`
        : `<span class="pw pw-ph">—</span>`;
    } else if(op.t==='extra'){
      return side==='l'
        ? `<span class="pw pw-ph">—</span>`
        : `<span class="pw pw-extra">${esc(op.bw)}</span>`;
    } else {
      return `<span class="pw pw-sub">${esc(side==='l'?op.aw:op.bw)}</span>`;
    }
  }

  // 문장에 오류가 있는지 확인
  function hasProblem(ops){ return ops.some(o=>o.t!=='ok'); }

  let rowsHTML = '';
  sentGroups.forEach((sg, idx) => {
    const lWords = sg.ops.map(o => wordHTML(o,'l')).join(' ');
    const rWords = sg.ops.map(o => wordHTML(o,'r')).join(' ');
    const prob = hasProblem(sg.ops);
    const rowBg = prob ? '' : '';
    const numColor = prob ? '#cc0000' : '#999';
    const lBg = prob ? 'background:#fff5f5;' : '';
    const rBg = prob ? 'background:#f5fff8;' : '';
    rowsHTML += `
      <div class="pv-row" style="${rowBg}">
        <div class="pv-cell pv-orig" style="${lBg}">
          <span class="pv-num" style="color:${numColor};">${idx+1}</span>
          <div class="pv-words">${lWords}</div>
        </div>
        <div class="pv-cell pv-rec" style="${rBg}">
          <span class="pv-num" style="color:${numColor};">${idx+1}</span>
          <div class="pv-words">${rWords}</div>
        </div>
      </div>`;
  });

  return `
    <div style="background:#ffffff !important;color:#000 !important;color-scheme:light !important;min-height:100%;">
    <div class="pv-header">
      <div class="pv-title">전도폭발훈련 전문 구두점검</div>
      <div class="pv-subtitle">${d.chInfo}</div>
      <div class="pv-meta">출력일시: ${dateStr} &nbsp;|&nbsp; 일치율: ${d.accuracy}% (${d.grade}) &nbsp;|&nbsp; 일치 ${d.correct} / 누락 ${d.missing} / 추가 ${d.extra} / 대체 ${d.sub}</div>
      <div class="pv-legend">
        <div class="pv-legend-item"><span class="pv-leg-sample pw-miss">단어</span> 누락(빨강)</div>
        <div class="pv-legend-item"><span class="pv-leg-sample pw-extra">단어</span> 추가(파랑)</div>
        <div class="pv-legend-item"><span class="pv-leg-sample pw-sub">단어</span> 대체·오타(보라)</div>
      </div>
    </div>
    <div class="pv-progress-wrap">
      <div class="pv-progress-label"><span>일치율</span><span>${d.accuracy}%</span></div>
      <div class="pv-progress-track">
        <div class="pv-progress-fill" style="width:${d.accuracy}%;background:${d.bc};"></div>
      </div>
    </div>
    <div class="pv-table">
      <div class="pv-table-header">
        <div class="pv-th">원본 텍스트</div>
        <div class="pv-th">녹음 텍스트</div>
      </div>
      ${rowsHTML}
    </div>
    </div>
  `;
}

