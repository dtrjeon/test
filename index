document.getElementById('btn-whisper-transcribe').addEventListener('click', async function(){
  if(!audioBlob){ alert('먼저 녹음을 완료해 주세요.\n녹음 시작 → 말하기 → 녹음 중지'); return; }
  if(!whisperApiKey){ alert('API 키를 먼저 입력하고 저장해 주세요.'); return; }

  const btn = this;
  const statusEl = document.getElementById('whisper-status');
  btn.disabled = true;
  btn.classList.add('loading');
  document.getElementById('whisper-btn-label').textContent = '변환 중...';
  statusEl.textContent = '🤖 Whisper AI가 음성을 분석하고 있습니다...';

  try {
    // audioBlob → File 객체로 변환
    const ext = audioExt || 'webm';
    const mimeMap = { m4a:'audio/mp4', webm:'audio/webm', ogg:'audio/ogg' };
    const mime = mimeMap[ext] || 'audio/webm';
    const audioFile = new File([audioBlob], '녹음.' + ext, { type: mime });

    const formData = new FormData();
    formData.append('file', audioFile);
    formData.append('model', 'whisper-1');
    formData.append('language', 'ko'); // 한국어 고정

    const response = await fetch('https://api.openai.com/v1/audio/transcriptions', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + whisperApiKey },
      body: formData
    });

    if(!response.ok){
      const err = await response.json().catch(()=>({}));
      if(response.status === 401){
        throw new Error('API 키가 올바르지 않습니다. 키를 다시 확인해 주세요.');
      } else if(response.status === 429){
        throw new Error('API 사용 한도 초과. 잠시 후 다시 시도해 주세요.');
      } else {
        throw new Error((err.error && err.error.message) || 'API 오류: ' + response.status);
      }
    }

    const data = await response.json();
    const text = data.text ? data.text.trim() : '';

    if(!text){ throw new Error('텍스트 변환 결과가 없습니다. 다시 녹음해 주세요.'); }

    // 결과 적용
    transcript = numToKor(text);
    recordedText = numToKor(text);
    updateRecordedPreview();

    // 음성 저장 버튼 활성화 (텍스트 저장 포함)
    document.getElementById('btn-save-audio').disabled = false;
    document.getElementById('btn-save-audio').classList.add('ready');

    statusEl.textContent = '✓ 변환 완료! ' + text.length + '자';
    showBanner('✓ Whisper 텍스트 추출 완료!<br>아래 <strong>비교 분석</strong> 버튼을 누르세요.', 'ok');
    setStatus('Whisper 변환 완료 ✓ — 비교 분석 버튼을 누르세요');

  } catch(e) {
    statusEl.textContent = '⚠ ' + e.message;
    showBanner('⚠ ' + e.message, 'err');
  } finally {
    btn.disabled = false;
    btn.classList.remove('loading');
    document.getElementById('whisper-btn-label').textContent = '녹음 후 텍스트 추출 (Whisper)';
  }
});

