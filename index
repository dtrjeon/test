document.getElementById('btn-save-audio').addEventListener('click', function(){
  const ts = makeTimestamp();
  const audioFilename = '녹음_' + ts + '.' + (audioExt || 'webm');

  // 음성 없고 텍스트만 있는 경우 (음성 저장 불가 환경)
  // STT 모드는 stopRec()에서 이미 저장됐으므로 안내만 표시
  if(!audioBlob){
    // 음성 저장 불가 환경 — 텍스트만 저장
    const textOnly = transcript.trim() || recordedText.trim();
    if(!textOnly){ alert('저장할 내용이 없습니다.'); return; }
    saveTxtFile(ts, textOnly);
    setStatus('텍스트 파일이 저장되었습니다: 녹음_' + ts + '.txt');
    return;
  }

  // ── Whisper 모드: 음성만 저장 후 Whisper 추출 안내 ──
  if(recMode === 'api'){
    const url = URL.createObjectURL(audioBlob);
    const a = document.createElement('a');
    a.href = url; a.download = audioFilename;
    document.body.appendChild(a); a.click();
    document.body.removeChild(a); URL.revokeObjectURL(url);
    setStatus('음성 저장 완료 ✓ — ⑤ 텍스트 추출(Whisper) 버튼을 누르세요');
    showBanner('✓ 음성(.'+audioExt+') 저장 완료!<br>이제 아래 <strong>⑤ 텍스트 추출(Whisper)</strong> 버튼을 눌러 텍스트를 추출하세요.', 'ok');
    return;
  }

  // ── STT 모드: txt 먼저 저장 → 1초 후 오디오 저장 (브라우저 연속 다운로드 차단 방지) ──
  const savedText = transcript.trim() || recordedText.trim();
  if(!savedText){
    const url = URL.createObjectURL(audioBlob);
    const a = document.createElement('a');
    a.href = url; a.download = audioFilename;
    document.body.appendChild(a); a.click();
    document.body.removeChild(a); URL.revokeObjectURL(url);
    setStatus('음성 저장 완료 ✓ (STT 텍스트 없음)');
    showBanner('✓ 음성(.'+audioExt+') 저장 완료.', 'ok');
    return;
  }
  recordedText = savedText;
  // txt 먼저 저장
  saveTxtFile(ts, savedText);
  setStatus('텍스트 저장 중... 잠시 후 음성 파일이 저장됩니다');
  // 1초 후 오디오 저장
  setTimeout(() => {
    const url = URL.createObjectURL(audioBlob);
    const a = document.createElement('a');
    a.href = url; a.download = audioFilename;
    document.body.appendChild(a); a.click();
    document.body.removeChild(a); URL.revokeObjectURL(url);
    setStatus('음성 + 텍스트 저장 완료 ✓ — 비교 분석 버튼을 누르세요');
    showBanner('✓ 녹음_' + ts + '.txt 및 녹음_' + ts + '.' + (audioExt||'webm') + ' 저장 완료!', 'ok');
  }, 1000);
});

