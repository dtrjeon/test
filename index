<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0e0f11">
<title>전도폭발훈련 전문 구두점검</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0e0f11;--surface:#17191d;--surface2:#1e2127;
  --border:#2a2d35;--border2:#363a45;
  --text:#e8eaf0;--text-muted:#7a7f8e;--text-dim:#4a4f5e;
  --green:#4ade80;--green-bg:rgba(74,222,128,.13);--green-border:rgba(74,222,128,.3);
  --red:#f87171;--red-bg:rgba(248,113,113,.13);--red-border:rgba(248,113,113,.3);
  --amber:#fbbf24;--amber-bg:rgba(251,191,36,.12);--amber-border:rgba(251,191,36,.25);
  --blue:#60a5fa;--blue-bg:rgba(96,165,250,.12);--blue-border:rgba(96,165,250,.25);
  --accent:#7c6aff;--accent-glow:rgba(124,106,255,.22);
  --clova:#00c471;--clova-bg:rgba(0,196,113,.12);--clova-border:rgba(0,196,113,.3);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;}
body{background:var(--bg);color:var(--text);font-family:'Noto Sans KR',sans-serif;font-weight:300;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
.page{max-width:480px;margin:0 auto;padding:20px 16px 48px;}

/* Header */
.header{margin-bottom:22px;position:relative;}
.tag{display:inline-block;font-size:10px;letter-spacing:.12em;color:var(--accent);border:1px solid var(--accent-glow);background:var(--accent-glow);padding:3px 10px;border-radius:20px;margin-bottom:10px;text-transform:uppercase;}
h1{font-size:24px;font-weight:700;letter-spacing:-.02em;line-height:1.2;}
.subtitle{margin-top:6px;font-size:13px;color:var(--text-muted);}
.slabel{font-size:10px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--text-dim);margin-bottom:8px;}

/* 배너 */
.banner{border-radius:10px;padding:12px 14px;font-size:13px;margin-bottom:14px;line-height:1.6;display:none;}
.banner-warn{background:var(--amber-bg);border:1px solid var(--amber-border);color:var(--amber);}
.banner-ok{background:var(--green-bg);border:1px solid var(--green-border);color:var(--green);}
.banner-err{background:var(--red-bg);border:1px solid var(--red-border);color:var(--red);}

/* ── 서버 연결 상태 표시등 ── */
.server-dot{
  display:inline-block;width:11px;height:11px;border-radius:50%;
  background:#4a4f5e; /* 기본: 회색 (테스트 모드) */
  flex-shrink:0;
  box-shadow:0 0 0 2px rgba(255,255,255,.08);
  transition:background .4s, box-shadow .4s;
}
.server-dot.connected{
  background:#4ade80;
  box-shadow:0 0 0 3px rgba(74,222,128,.25), 0 0 8px rgba(74,222,128,.5);
  animation:dot-pulse-green 2.5s ease-in-out infinite;
}
.server-dot.disconnected{
  background:#f87171;
  box-shadow:0 0 0 3px rgba(248,113,113,.25), 0 0 8px rgba(248,113,113,.5);
  animation:dot-pulse-red 2.5s ease-in-out infinite;
}
.server-dot.checking{
  background:#fbbf24;
  box-shadow:0 0 0 3px rgba(251,191,36,.25);
  animation:dot-blink .8s ease-in-out infinite;
}
@keyframes dot-pulse-green{
  0%,100%{box-shadow:0 0 0 2px rgba(74,222,128,.2),0 0 6px rgba(74,222,128,.4);}
  50%    {box-shadow:0 0 0 4px rgba(74,222,128,.1),0 0 14px rgba(74,222,128,.6);}
}
@keyframes dot-pulse-red{
  0%,100%{box-shadow:0 0 0 2px rgba(248,113,113,.2),0 0 6px rgba(248,113,113,.4);}
  50%    {box-shadow:0 0 0 4px rgba(248,113,113,.1),0 0 14px rgba(248,113,113,.6);}
}
@keyframes dot-blink{
  0%,100%{opacity:1;} 50%{opacity:.3;}
}

/* ── 로그 모드 카드 ── */
.log-mode-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 14px;margin-bottom:10px;}
.log-mode-row{display:flex;align-items:center;justify-content:space-between;gap:10px;}
.log-mode-info{display:flex;align-items:center;gap:10px;}
.log-mode-icon{font-size:22px;flex-shrink:0;}
.log-mode-title{font-size:14px;font-weight:600;color:var(--text);line-height:1.3;}
.log-mode-desc{font-size:11px;color:var(--text-muted);margin-top:2px;}

.btn-url-test{flex-shrink:0;padding:8px 12px;border-radius:8px;border:1px solid var(--border2);background:var(--surface2);color:var(--text-muted);font-family:'Noto Sans KR',sans-serif;font-size:12px;cursor:pointer;white-space:nowrap;touch-action:manipulation;}
.btn-url-test:active{background:var(--border);}
.gas-guide{margin-top:8px;font-size:12px;color:var(--clova);line-height:1.7;padding:8px 12px;background:var(--clova-bg);border:1px solid var(--clova-border);border-radius:8px;}
.gas-guide strong{font-weight:600;}

/* 자물쇠 버튼 */
.btn-admin-lock{
  flex-shrink:0;width:36px;height:36px;border-radius:50%;
  border:1.5px solid var(--border2);background:var(--surface2);
  font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;
  touch-action:manipulation;transition:border-color .2s,background .2s;
}
.btn-admin-lock:active{background:var(--border);}
.btn-admin-lock.unlocked{border-color:var(--clova-border);background:var(--clova-bg);font-size:15px;}

/* 관리자 모달 */
.admin-modal{display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.75);align-items:center;justify-content:center;}
.admin-modal.open{display:flex;}
.admin-box{background:var(--surface);border:1px solid var(--border2);border-radius:16px;width:300px;max-width:90vw;overflow:hidden;}
.admin-header{display:flex;align-items:center;gap:8px;padding:14px 16px;background:var(--surface2);border-bottom:1px solid var(--border);}
.admin-header-icon{font-size:18px;}
.admin-header-title{flex:1;font-size:15px;font-weight:600;color:var(--text);}
.admin-close{background:none;border:none;color:var(--text-muted);font-size:16px;cursor:pointer;padding:2px 6px;border-radius:6px;}
.admin-close:active{background:var(--border);}
.admin-body{padding:16px;}
.admin-desc{font-size:13px;color:var(--text-muted);margin-bottom:12px;line-height:1.5;}
.admin-pw-input{
  width:100%;background:var(--surface2);border:1.5px solid var(--border2);
  border-radius:10px;padding:10px 14px;color:var(--text);
  font-family:'Noto Sans KR',sans-serif;font-size:15px;outline:none;
  box-sizing:border-box;margin-bottom:8px;
}
.admin-pw-input:focus{border-color:var(--accent);}
.admin-err{font-size:12px;color:var(--red);margin-bottom:8px;padding:6px 10px;background:var(--red-bg);border:1px solid var(--red-border);border-radius:8px;}
.btn-admin-confirm{
  width:100%;min-height:46px;border-radius:10px;border:none;
  background:var(--accent);color:#fff;
  font-family:'Noto Sans KR',sans-serif;font-size:15px;font-weight:500;
  cursor:pointer;touch-action:manipulation;
}
.admin-setting-row{display:flex;align-items:center;justify-content:space-between;padding:4px 0;}
.admin-setting-label{font-size:14px;color:var(--text);font-weight:500;}
.btn-admin-confirm:active{background:#6a59ee;}

/* 모드 카드 - 서버모드 활성 표시 */
.log-mode-card.server-active{border-color:var(--clova-border);background:var(--clova-bg);}

/* 모드 토글 */
.log-toggle-switch{position:relative;display:inline-block;width:52px;height:28px;flex-shrink:0;}
.log-toggle-switch input{opacity:0;width:0;height:0;position:absolute;}
.log-toggle-track{position:absolute;inset:0;border-radius:14px;background:var(--surface2);border:1.5px solid var(--border2);transition:background .25s,border-color .25s;}
.log-toggle-switch input:checked ~ .log-toggle-track{background:var(--clova);border-color:var(--clova);}
.log-toggle-thumb{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:transform .25s;box-shadow:0 1px 4px rgba(0,0,0,.3);}
.log-toggle-switch input:checked ~ .log-toggle-track .log-toggle-thumb{transform:translateX(24px);}

/* 서버 URL 입력 */
.server-url-row{display:flex;gap:8px;margin-top:10px;}
.server-url-input{flex:1;min-width:0;background:var(--surface2);border:1px solid var(--border2);border-radius:8px;padding:8px 12px;color:var(--text);font-family:'Noto Sans KR',sans-serif;font-size:13px;outline:none;}
.server-url-input::placeholder{color:var(--text-dim);}
.server-url-input:focus{border-color:var(--clova);}
.btn-url-save{flex-shrink:0;padding:8px 14px;border-radius:8px;border:1.5px solid var(--clova-border);background:var(--clova-bg);color:var(--clova);font-family:'Noto Sans KR',sans-serif;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;touch-action:manipulation;}
.btn-url-save:active{background:var(--clova);color:#fff;}
.server-status{margin-top:8px;font-size:12px;padding:6px 10px;border-radius:8px;line-height:1.5;}
.server-status.ok{background:var(--green-bg);color:var(--green);border:1px solid var(--green-border);}
.server-status.err{background:var(--red-bg);color:var(--red);border:1px solid var(--red-border);}
.server-status.sending{background:var(--amber-bg);color:var(--amber);border:1px solid var(--amber-border);}

/* ── 사용자 입력 카드 ── */
.user-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:14px;}
.user-card-header{display:flex;align-items:center;gap:8px;padding:8px 14px;border-bottom:1px solid var(--border);background:var(--surface2);}
.user-input{width:100%;background:transparent;border:none;outline:none;color:var(--text);font-family:'Noto Sans KR',sans-serif;font-size:15px;font-weight:400;padding:10px 14px;}
.user-input::placeholder{color:var(--text-dim);}

/* ── 로그 버튼 영역 ── */
.log-row{display:flex;gap:8px;margin-bottom:14px;}
.btn-log{flex:1;min-height:42px;border-radius:10px;border:1px solid var(--border2);background:var(--surface2);color:var(--text-muted);font-family:'Noto Sans KR',sans-serif;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;touch-action:manipulation;}
.btn-log:active{background:var(--border);}
.btn-log.accent{border-color:var(--accent);background:var(--accent-glow);color:var(--accent);}

.btn-log-tool.analysis{background:rgba(124,106,255,.2);color:var(--accent);border:1px solid rgba(124,106,255,.4);}
.analysis-select{flex:1;min-width:100px;background:var(--surface2);border:1px solid var(--border2);border-radius:8px;padding:7px 10px;color:var(--text);font-family:'Noto Sans KR',sans-serif;font-size:13px;outline:none;}
.btn-analysis-run{padding:7px 16px;border-radius:8px;border:none;background:var(--accent);color:#fff;font-family:'Noto Sans KR',sans-serif;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;touch-action:manipulation;}
.btn-analysis-run:active{background:#6a59ee;}
.analysis-sessions{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
.session-chip{padding:4px 10px;border-radius:20px;font-size:11px;font-weight:500;border:1px solid var(--border2);background:var(--surface2);color:var(--text-muted);}
.session-chip.best{border-color:var(--green-border);background:var(--green-bg);color:var(--green);}
.analysis-section-title{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dim);margin:14px 0 8px;padding-bottom:5px;border-bottom:1px solid var(--border);}
.heatmap-wrap{line-height:2.6;word-break:keep-all;}
.hw{display:inline-block;border-radius:5px;padding:2px 5px;margin:2px 2px;font-size:14px;cursor:default;position:relative;}
.hw-ok{color:var(--text);}
.hw-err1{background:rgba(251,191,36,.20);border:1px solid rgba(251,191,36,.35);color:#fbbf24;}
.hw-err2{background:rgba(248,113,113,.25);border:1px solid rgba(248,113,113,.45);color:#f87171;}
.hw-err3{background:rgba(248,113,113,.55);border:1px solid #f87171;color:#fff;font-weight:600;}
.hw[data-tip]:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 4px);left:50%;transform:translateX(-50%);background:#1a1c21;border:1px solid var(--border2);border-radius:6px;padding:4px 8px;font-size:11px;color:var(--text);white-space:nowrap;z-index:100;pointer-events:none;}
.err-word-list{display:flex;flex-direction:column;gap:6px;}
.err-word-row{display:flex;align-items:center;gap:8px;padding:7px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;}
.err-word-orig{font-size:14px;font-weight:600;color:var(--red);min-width:60px;}
.err-word-bar-wrap{flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden;}
.err-word-bar{height:100%;border-radius:3px;background:var(--red);}
.err-word-cnt{font-size:12px;color:var(--text-muted);white-space:nowrap;}
.err-word-sub{font-size:11px;color:var(--blue);}

/* ── 로그 모달 ── */
.log-modal{display:none;position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,.8);overflow-y:auto;}
.log-modal.open{display:block;}
.log-box{max-width:480px;margin:20px auto;background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.log-toolbar{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--surface2);border-bottom:1px solid var(--border);}
.log-toolbar-title{font-size:14px;font-weight:600;color:var(--text);}
.log-toolbar-btns{display:flex;gap:8px;}
.btn-log-tool{padding:6px 14px;border-radius:8px;border:none;font-family:'Noto Sans KR',sans-serif;font-size:12px;font-weight:500;cursor:pointer;touch-action:manipulation;}
.btn-log-tool.csv{background:var(--accent);color:#fff;}
.btn-log-tool.del{background:#2a2d35;color:var(--red);}
.btn-log-tool.close{background:#2a2d35;color:var(--text-muted);}
.log-table-wrap{overflow-x:auto;padding:12px;}
.log-table{width:100%;border-collapse:collapse;font-size:12px;}
.log-table th{text-align:left;padding:6px 8px;color:var(--text-dim);font-weight:500;border-bottom:1px solid var(--border);white-space:nowrap;}
.log-table td{padding:7px 8px;color:var(--text);border-bottom:1px solid var(--border2);vertical-align:top;}
.log-table tr:last-child td{border-bottom:none;}
.log-empty{text-align:center;padding:32px;color:var(--text-dim);font-size:13px;}
.log-badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;}
.btn-log-replay{
  padding:3px 8px;border-radius:5px;border:1px solid var(--accent);
  background:var(--accent-glow);color:var(--accent);
  font-family:'Noto Sans KR',sans-serif;font-size:11px;font-weight:500;
  cursor:pointer;white-space:nowrap;touch-action:manipulation;
}
.btn-log-replay:active{background:var(--accent);color:#fff;}

/* ── 미리보기: 누적오류 섹션 ── */
.pv-acc-section{margin-top:6mm;padding:3mm 4mm;border:1pt solid #e0c0c0;border-radius:2mm;background:#fff8f8;}
.pv-acc-title{font-size:9pt;font-weight:700;color:#cc0000;margin-bottom:2mm;letter-spacing:.04em;}
.pv-acc-grid{display:flex;flex-wrap:wrap;gap:3px;}
.pv-acc-chip{
  display:inline-flex;align-items:center;gap:3px;
  padding:2px 7px;border-radius:4px;font-size:10pt;
  border:1px solid;
}
.pv-acc-chip.freq3{background:#f4cccc;border-color:#cc0000;color:#990000;font-weight:700;}
.pv-acc-chip.freq2{background:#fce5cd;border-color:#e06020;color:#c05010;}
.pv-acc-chip.freq1{background:#fff2cc;border-color:#c0a000;color:#806000;}
.pv-acc-cnt{font-size:8pt;opacity:.75;}

/* 미리보기: 반복오류 단어 강조 (원본 열) */
.pw-repeat{
  background:#f4cccc !important;
  border:1.5px solid #cc0000 !important;
  color:#990000 !important;
  font-weight:700;
}

/* Chapter */
.chapter-section{margin-bottom:20px;}
.mode-row{display:flex;gap:8px;margin-bottom:10px;}
.mode-btn{flex:1;padding:10px 0;border-radius:8px;border:1px solid var(--border2);background:var(--surface2);color:var(--text-muted);font-family:'Noto Sans KR',sans-serif;font-size:13px;cursor:pointer;text-align:center;min-height:44px;touch-action:manipulation;}
.mode-btn.active{background:var(--accent-glow);border-color:var(--accent);color:var(--accent);font-weight:500;}
.chapters-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:10px;}
.chapter-btn{position:relative;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:14px 12px 12px;cursor:pointer;text-align:left;user-select:none;min-height:64px;touch-action:manipulation;width:100%;}
.chapter-btn.selected{border-color:var(--accent);background:var(--accent-glow);}
.ch-num{font-size:10px;color:var(--text-dim);margin-bottom:3px;}
.chapter-btn.selected .ch-num{color:var(--accent);}
.ch-title{font-size:16px;font-weight:500;color:var(--text);}
.ch-order{position:absolute;top:8px;right:9px;width:20px;height:20px;border-radius:50%;background:var(--accent);color:#fff;font-size:11px;font-weight:700;display:none;align-items:center;justify-content:center;}
.chapter-btn.selected .ch-order{display:flex;}
.preview-box{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:10px 14px;min-height:48px;}
.preview-chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:5px;}
.preview-chip{background:var(--accent-glow);border:1px solid var(--accent);border-radius:4px;padding:2px 8px;font-size:11px;color:var(--accent);}
.preview-snip{font-size:12px;color:var(--text-muted);line-height:1.5;}
.preview-empty{font-size:12px;color:var(--text-dim);}

/* 원본 텍스트 카드 */
.input-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:10px;}
.input-card-header{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border);background:var(--surface2);}
.card-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.card-title{font-size:11px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);}
textarea{width:100%;background:transparent;border:none;outline:none;color:var(--text);font-family:'Noto Sans KR',sans-serif;font-size:15px;font-weight:300;line-height:1.7;padding:14px;resize:none;min-height:90px;}
textarea::placeholder{color:var(--text-dim);}

/* ── 입력방식 탭 ── */
.input-mode-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:10px;}
.input-mode-tabs{display:flex;border-bottom:1px solid var(--border);}
.input-tab{
  flex:1;padding:12px 8px;text-align:center;
  font-family:'Noto Sans KR',sans-serif;font-size:13px;font-weight:400;
  color:var(--text-dim);background:var(--surface2);
  border:none;cursor:pointer;touch-action:manipulation;
  border-bottom:2px solid transparent;
  transition:color .15s,border-color .15s,background .15s;
}
.input-tab.active-mic{color:var(--red);border-bottom-color:var(--red);background:var(--surface);}
.input-tab.active-clova{color:var(--clova);border-bottom-color:var(--clova);background:var(--surface);}
.tab-icon{display:block;font-size:18px;margin-bottom:2px;}
.tab-label{font-size:11px;}

/* 탭 패널 */
.tab-panel{display:none;padding:14px;}
.tab-panel.active{display:block;}

/* 마이크 권한 버튼 */
.btn-permission{
  width:100%;min-height:48px;border-radius:10px;
  border:1.5px solid var(--amber-border);background:var(--amber-bg);
  color:var(--amber);font-family:'Noto Sans KR',sans-serif;
  font-size:14px;font-weight:500;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  margin-bottom:10px;touch-action:manipulation;
}
.btn-permission.granted{border-color:var(--green-border);background:var(--green-bg);color:var(--green);}

/* 녹음 버튼 */
.btn-rec-main{
  width:100%;min-height:56px;border-radius:12px;
  border:1.5px solid var(--red-border);background:var(--red-bg);
  color:var(--red);font-family:'Noto Sans KR',sans-serif;
  font-size:16px;font-weight:500;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:10px;
  touch-action:manipulation;
  transition:background .15s,color .15s,border-color .15s;
  margin-bottom:8px;
}
.btn-rec-main.recording{background:var(--red);color:#fff;border-color:var(--red);animation:rpulse 1.5s ease-in-out infinite;}
@keyframes rpulse{0%,100%{box-shadow:0 0 0 0 rgba(248,113,113,.4);}50%{box-shadow:0 0 0 12px rgba(248,113,113,0);}}
.rec-dot{width:14px;height:14px;border-radius:50%;background:currentColor;flex-shrink:0;}
.btn-rec-main.recording .rec-dot{animation:blink 1s infinite;}

/* 저장 버튼 */
.save-row{display:flex;gap:8px;margin-top:8px;}
.btn-save{
  flex:1;min-height:46px;border-radius:10px;
  border:1px solid var(--border2);background:var(--surface2);
  color:var(--text-muted);font-family:'Noto Sans KR',sans-serif;
  font-size:13px;font-weight:400;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:6px;
  touch-action:manipulation;transition:background .15s,color .15s,border-color .15s;
}
.btn-save:active{background:var(--border);}
.btn-save.ready{border-color:var(--green-border);background:var(--green-bg);color:var(--green);}
.btn-save[disabled]{opacity:.3;cursor:not-allowed;}
.btn-print{width:100%;margin-bottom:8px;}
.btn-preview-wrap{display:flex;gap:8px;margin-bottom:8px;}
.btn-preview-wrap .btn-save{flex:1;min-height:46px;border-radius:10px;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}

/* 클로바노트 패널 */
.clova-guide{
  background:var(--clova-bg);border:1px solid var(--clova-border);
  border-radius:10px;padding:12px 14px;margin-bottom:10px;
  font-size:13px;color:var(--clova);line-height:1.8;
}
.clova-guide strong{font-weight:500;}
.clova-guide ol{padding-left:16px;margin-top:4px;}
.clova-guide li{margin-bottom:2px;}
.clova-paste-area{
  width:100%;min-height:120px;background:var(--surface2);
  border:1.5px dashed var(--clova-border);border-radius:10px;
  outline:none;color:var(--text);font-family:'Noto Sans KR',sans-serif;
  font-size:15px;font-weight:300;line-height:1.7;padding:14px;
  resize:none;
}
.clova-paste-area::placeholder{color:var(--text-dim);}
.clova-paste-area:focus{border-color:var(--clova);border-style:solid;}
.btn-clova-apply{
  width:100%;min-height:48px;border-radius:10px;margin-top:8px;
  border:1.5px solid var(--clova-border);background:var(--clova-bg);
  color:var(--clova);font-family:'Noto Sans KR',sans-serif;
  font-size:15px;font-weight:500;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  touch-action:manipulation;
}
.btn-clova-apply:active{background:rgba(0,196,113,.25);}

/* 파일 불러오기 */
.btn-file-upload{
  width:100%;min-height:52px;border-radius:10px;
  border:1.5px dashed var(--clova-border);background:var(--surface2);
  color:var(--clova);font-family:'Noto Sans KR',sans-serif;
  font-size:15px;font-weight:500;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  touch-action:manipulation;transition:background .15s;margin-bottom:6px;
}
.btn-file-upload:active{background:var(--clova-bg);}
.file-name-tag{
  display:none;padding:6px 12px;margin-bottom:8px;
  background:var(--clova-bg);border:1px solid var(--clova-border);
  border-radius:8px;font-size:12px;color:var(--clova);
  text-align:center;word-break:break-all;
}
.divider-or{
  display:flex;align-items:center;gap:8px;
  margin:10px 0;font-size:11px;color:var(--text-dim);letter-spacing:.06em;
}
.divider-or::before,.divider-or::after{content:'';flex:1;height:1px;background:var(--border2);}

/* 녹음 텍스트 미리보기 */
.recorded-preview{
  background:var(--surface2);border:1px solid var(--border);
  border-radius:10px;padding:10px 14px;margin-top:10px;
  font-size:13px;color:var(--text-muted);line-height:1.6;min-height:44px;
}
.recorded-preview-label{font-size:10px;color:var(--text-dim);letter-spacing:.06em;text-transform:uppercase;margin-bottom:4px;}
.recorded-preview-text{font-size:14px;color:var(--text);}
.recorded-preview-empty{font-size:13px;color:var(--text-dim);}

/* 분석/초기화 버튼 */
.bottom-btns{margin-top:10px;}
.btn-analyze{
  width:100%;min-height:56px;border-radius:14px;
  border:none;background:var(--accent);color:#fff;
  font-family:'Noto Sans KR',sans-serif;font-size:17px;font-weight:500;
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;
  touch-action:manipulation;margin-bottom:8px;
}
.btn-analyze:active{background:#6a59ee;}
.btn-row2{display:flex;gap:8px;}
.btn-sm{
  flex:1;min-height:46px;border-radius:10px;
  border:1px solid var(--border2);background:var(--surface2);
  color:var(--text-muted);font-family:'Noto Sans KR',sans-serif;
  font-size:14px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:6px;
  touch-action:manipulation;
}
.btn-sm:active{background:var(--border);}
.status-bar{text-align:center;font-size:13px;color:var(--text-dim);margin-top:10px;min-height:20px;padding:4px;}

/* 범례 */
.legend{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;padding:10px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:10px;}
.leg{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--text-muted);}
.leg-chip{display:inline-block;padding:1px 7px;border-radius:4px;font-size:11px;font-weight:500;}

/* 결과 */
.result-panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.empty-state{padding:36px 20px;text-align:center;color:var(--text-dim);font-size:13px;}
.score-bar{padding:16px;background:var(--surface2);border-bottom:1px solid var(--border);}
.score-top{display:flex;align-items:center;gap:12px;margin-bottom:12px;}
.score-badge{font-size:38px;font-weight:700;line-height:1;}
.score-info{flex:1;}
.score-chapter{font-size:10px;color:var(--text-dim);margin-bottom:3px;}
.score-grade{font-size:16px;font-weight:500;}
.score-desc{font-size:12px;color:var(--text-muted);margin-top:2px;}
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;}
.stat-chip{border-radius:8px;padding:7px 4px;text-align:center;border:1px solid;}
.stat-num{font-size:20px;font-weight:700;display:block;line-height:1.1;}
.stat-lbl{font-size:10px;opacity:.8;}
.diff-section{padding:16px;}
.diff-block{margin-bottom:22px;}
.diff-block:last-child{margin-bottom:0;}
.diff-block-title{font-size:10px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dim);margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--border);}
.diff-content{font-size:15px;line-height:2.5;word-break:keep-all;}
.w{display:inline-block;border-radius:5px;padding:1px 5px;margin:2px 2px;font-size:15px;}
.w-ok{color:var(--text);}
.w-miss{background:var(--red-bg);border:1px solid var(--red-border);color:var(--red);text-decoration:line-through;text-decoration-color:rgba(248,113,113,.5);}
.w-extra{background:var(--amber-bg);border:1px solid var(--amber-border);color:var(--amber);}
.w-sub{background:var(--blue-bg);border:1px solid var(--blue-border);color:var(--blue);}
.w-ph{color:var(--text-dim);font-size:12px;padding:2px 6px;}
.progress-wrap{padding:12px 16px;border-top:1px solid var(--border);background:var(--surface2);}
.progress-label{display:flex;justify-content:space-between;font-size:11px;color:var(--text-dim);margin-bottom:6px;}
.progress-track{height:5px;background:var(--border);border-radius:3px;overflow:hidden;}
.progress-fill{height:100%;border-radius:3px;transition:width .7s ease;}

/* ════════════ 프린트 스타일 (A4) ════════════ */
@media print {
  /* A4 페이지 설정 */
  @page {
    size: A4 portrait;
    margin: 15mm 12mm 15mm 12mm;
  }

  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    color-scheme: light !important;
  }

  html, body {
    background: #ffffff !important;
    color: #000000 !important;
    font-family: 'Noto Sans KR', sans-serif;
    font-size: 10pt;
    width: 100%;
    margin: 0; padding: 0;
    color-scheme: light !important;
  }

  /* 미리보기 모달 프린트 모드 */
  .preview-modal {
    display: block !important;
    position: static !important;
    background: #ffffff !important;
    overflow: visible !important;
  }
  .preview-toolbar { display: none !important; }
  .preview-a4 {
    width: 100% !important;
    min-width: unset !important;
    min-height: unset !important;
    margin: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
    background: #ffffff !important;
    color: #000000 !important;
  }

  /* 화면 UI 모두 숨기기 */
  .header, .chapter-section, .input-card, .input-mode-card,
  .recorded-preview, .bottom-btns, .legend,
  .result-panel .score-bar .stats-row,
  #banner, .btn-print,
  .page { display: none !important; }

  #result-area { display: block !important; }
  .result-panel { border: none !important; border-radius: 0 !important; box-shadow: none !important; }

  /* ── 인쇄 머리글 ── */
  .print-header {
    display: block !important;
    margin-bottom: 8mm;
  }
  .print-header-title {
    font-size: 14pt;
    font-weight: 700;
    border-bottom: 2px solid #000;
    padding-bottom: 3mm;
    margin-bottom: 2mm;
  }
  .print-header-meta {
    font-size: 9pt;
    color: #555;
    margin-bottom: 2mm;
  }
  .print-legend {
    display: flex !important;
    gap: 12mm;
    font-size: 8.5pt;
    color: #333;
    flex-wrap: wrap;
    border: 0.5pt solid #ccc;
    padding: 2mm 3mm;
    border-radius: 1mm;
    background: #f9f9f9;
  }
  .print-legend-item { display: flex; align-items: center; gap: 2mm; }

  /* ── 점수 영역 ── */
  .score-bar {
    display: block !important;
    background: #f5f5f5 !important;
    border: 1pt solid #ccc !important;
    border-radius: 2mm !important;
    padding: 3mm 4mm !important;
    margin-bottom: 4mm;
  }
  .score-top {
    display: flex !important;
    align-items: center;
    gap: 4mm;
    margin-bottom: 0 !important;
  }
  .score-badge {
    font-size: 24pt !important;
    font-weight: 900 !important;
    color: #000 !important;
    line-height: 1;
    min-width: 18mm;
  }
  .score-grade { font-size: 13pt !important; font-weight: 700 !important; color: #000 !important; }
  .score-desc  { font-size: 9pt  !important; color: #444 !important; margin-top: 1mm; }
  .score-chapter { font-size: 8pt !important; color: #666 !important; margin-bottom: 1mm; }

  /* ── 좌우 2단 비교 본문 ── */
  .diff-section {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 0 !important;
    padding: 0 !important;
    border: 1pt solid #bbb;
    border-radius: 1mm;
    page-break-inside: auto;
  }
  .diff-block {
    margin-bottom: 0 !important;
    padding: 3mm 4mm !important;
    page-break-inside: auto;
  }
  .diff-block:first-child {
    border-right: 1pt solid #bbb !important;
  }
  .diff-block-title {
    font-size: 8pt !important;
    font-weight: 700 !important;
    color: #333 !important;
    letter-spacing: .06em;
    text-transform: uppercase;
    border-bottom: 0.5pt solid #ccc !important;
    padding-bottom: 1.5mm !important;
    margin-bottom: 2mm !important;
  }
  .diff-content {
    font-size: 10pt !important;
    line-height: 1.9 !important;
    word-break: keep-all;
  }

  /* ── 단어 표시 ── */
  .w { padding: 0.5mm 1.5mm !important; margin: 0.5mm 1mm !important; border-radius: 1mm !important; }
  .w-ok    { color: #000 !important; background: none !important; border: none !important; }
  .w-miss  {
    color: #000 !important; background: none !important; border: none !important;
    text-decoration: line-through !important; text-decoration-thickness: 1.5pt;
  }
  .w-extra { background: #ebebeb !important; border: 0.5pt solid #888 !important; color: #000 !important; }
  .w-sub   { background: #e0e0e0 !important; border: 0.5pt solid #888 !important; color: #000 !important; font-style: italic !important; }
  .w-ph    { color: #bbb !important; font-size: 8pt !important; }

  /* ── 일치율 바 ── */
  .progress-wrap {
    padding: 2mm 4mm !important;
    background: #f5f5f5 !important;
    border-top: 0.5pt solid #ccc !important;
    border-bottom-left-radius: 1mm;
    border-bottom-right-radius: 1mm;
  }
  .progress-label { font-size: 8pt !important; color: #444 !important; margin-bottom: 1.5mm; }
  .progress-track { height: 3mm !important; background: #ddd !important; border-radius: 1.5mm !important; }
  .progress-fill  { border-radius: 1.5mm !important; }
}

/* ════════════ 미리보기 모달 ════════════ */
.preview-modal{
  display:none;position:fixed;inset:0;z-index:9999;
  background:rgba(0,0,0,.7);
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
.preview-modal.open{ display:block; }
.preview-toolbar{
  position:sticky;top:0;z-index:10;
  display:flex;align-items:center;justify-content:space-between;
  background:#1a1a1a;padding:10px 16px;gap:10px;
  border-bottom:1px solid #333;
}
.preview-toolbar-title{font-size:14px;font-weight:500;color:#fff;}
.preview-toolbar-btns{display:flex;gap:8px;}
.preview-toolbar-btn{
  padding:7px 16px;border-radius:8px;border:none;
  font-family:'Noto Sans KR',sans-serif;font-size:13px;font-weight:500;
  cursor:pointer;touch-action:manipulation;
}
.preview-toolbar-btn.print{background:#7c6aff;color:#fff;}
.preview-toolbar-btn.close{background:#333;color:#ccc;}

/* A4 용지 */
.preview-a4{
  width:210mm;min-height:297mm;
  background:#ffffff !important;color:#000 !important;
  -webkit-print-color-adjust:exact !important;
  print-color-adjust:exact !important;
  color-scheme:light !important;
  margin:16px auto;
  padding:15mm 12mm;
  box-shadow:0 4px 24px rgba(0,0,0,.4);
  font-family:'Noto Sans KR',sans-serif;
  font-size:10pt;
  box-sizing:border-box;
}
/* 모바일에서도 A4 너비 유지 — 가로 스크롤로 확인 */
@media screen and (max-width:600px){
  .preview-modal{
    overflow-x:auto;
    overflow-y:auto;
  }
  .preview-a4{
    width:210mm;
    min-width:210mm;
    margin:0 auto;
    border-radius:0;
    padding:12mm 10mm;
  }
}

/* 미리보기 머리글 */
.pv-header{border-bottom:2pt solid #000;padding-bottom:3mm;margin-bottom:3mm;}
.pv-title{font-size:14pt;font-weight:700;margin-bottom:1.5mm;}
.pv-meta{font-size:9pt;color:#555;margin-bottom:2mm;}
.pv-legend{
  display:flex;gap:8mm;flex-wrap:wrap;
  font-size:8.5pt;color:#333;
  border:0.5pt solid #ccc;padding:1.5mm 3mm;
  border-radius:1mm;background:#f9f9f9;
}
.pv-legend-item{display:flex;align-items:center;gap:1.5mm;}

/* 2단 비교 */
.pv-subtitle{font-size:10pt;color:#444;margin-bottom:1mm;}
/* 표 형식 */
.pv-table{border:0.5pt solid #bbb;border-radius:2mm;overflow:hidden;}
.pv-table-header{
  display:grid;grid-template-columns:1fr 1fr;
  background:#f0f0f0;border-bottom:1pt solid #bbb;
}
.pv-th{
  padding:2mm 3mm;font-size:8pt;font-weight:700;
  color:#333;letter-spacing:.06em;text-transform:uppercase;
}
.pv-th:first-child{border-right:0.5pt solid #bbb;}
.pv-row{
  display:grid;grid-template-columns:1fr 1fr;
  border-bottom:0.5pt solid #e0e0e0;
}
.pv-row:last-child{border-bottom:none;}
.pv-cell{
  display:flex;align-items:flex-start;gap:2mm;
  padding:3mm 3mm;
  font-size:10.5pt;line-height:1.9;word-break:keep-all;
}
.pv-orig{border-right:0.5pt solid #bbb;}
.pv-num{
  font-size:8pt;font-weight:700;min-width:5mm;
  padding-top:1mm;flex-shrink:0;
  font-variant-numeric:tabular-nums;
}
.pv-words{flex:1;}
.pv-leg-sample{
  display:inline-block;border-radius:3px;
  padding:0 4px;font-size:8pt;
}

/* 미리보기 단어 색상 */
.pw{display:inline-block;border-radius:3px;padding:0 4px;margin:1px 2px;font-size:10pt;}
.pw-ok{color:#000;}
.pw-miss{background:#fff0f0;border:1px solid #ff4444;color:#cc0000;text-decoration:line-through;}
.pw-extra{background:#f0f4ff;border:1px solid #4466ff;color:#0033cc;}
.pw-sub{background:#f8f0ff;border:1px solid #8833cc;color:#6600aa;}
.pw-ph{color:#bbb;font-size:8pt;}

/* 일치율 바 */
.pv-progress-wrap{
  padding:2mm 4mm;border-top:0.5pt solid #ccc;
  background:#f9f9f9;border-bottom-left-radius:1mm;border-bottom-right-radius:1mm;
}
.pv-progress-label{display:flex;justify-content:space-between;font-size:8pt;color:#555;margin-bottom:1.5mm;}
.pv-progress-track{height:3mm;background:#ddd;border-radius:1.5mm;overflow:hidden;}
.pv-progress-fill{height:100%;border-radius:1.5mm;}

/* ── 녹음 방식 토글 스위치 ── */
.rec-mode-row{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:14px;padding:10px 14px;
  background:var(--surface2);border:1px solid var(--border);border-radius:10px;
}
.rec-mode-label{font-size:13px;color:var(--text-muted);font-weight:400;}
.rec-mode-label strong{color:var(--text);font-weight:500;}
.toggle-wrap{display:flex;align-items:center;gap:8px;}
.toggle-text{font-size:11px;font-weight:500;}
.toggle-text.api{color:var(--accent);}
.toggle-text.stt{color:var(--red);}
/* 토글 스위치 */
.toggle-switch{
  position:relative;width:52px;height:28px;
  cursor:pointer;touch-action:manipulation;
}
.toggle-switch input{opacity:0;width:0;height:0;position:absolute;}
.toggle-track{
  position:absolute;inset:0;border-radius:14px;
  background:var(--accent);
  transition:background .25s;
}
.toggle-switch input:checked ~ .toggle-track{ background:var(--red); }
.toggle-thumb{
  position:absolute;top:3px;left:3px;
  width:22px;height:22px;border-radius:50%;
  background:#fff;
  transition:transform .25s;
  box-shadow:0 1px 4px rgba(0,0,0,.3);
}
.toggle-switch input:checked ~ .toggle-track .toggle-thumb{
  transform:translateX(24px);
}
.rec-mode-panel{display:none;}
.rec-mode-panel.active{display:block;}

/* ════ Whisper API ════ */
.whisper-section{
  margin-top:10px;padding:12px 14px;
  background:var(--surface2);border:1px solid var(--border);
  border-radius:10px;
}
.whisper-label{font-size:10px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dim);margin-bottom:8px;}
.whisper-key-row{display:flex;gap:8px;margin-bottom:8px;align-items:stretch;}
.whisper-key-input{
  flex:1;min-width:0;background:var(--surface);border:1px solid var(--border2);
  border-radius:8px;padding:8px 12px;
  color:var(--text);font-family:'Noto Sans KR',sans-serif;font-size:13px;
  outline:none;box-sizing:border-box;
}
.whisper-key-input::placeholder{color:var(--text-dim);}
.whisper-key-input:focus{border-color:var(--accent);}
.btn-whisper-save{
  flex-shrink:0;padding:8px 14px;border-radius:8px;
  border:1px solid var(--accent);background:var(--accent-glow);
  color:var(--accent);font-family:'Noto Sans KR',sans-serif;
  font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;
  touch-action:manipulation;
}
.btn-whisper-save:active{background:var(--accent);color:#fff;}
.btn-whisper-transcribe{
  width:100%;min-height:48px;border-radius:10px;
  border:1.5px solid var(--accent);background:var(--accent-glow);
  color:var(--accent);font-family:'Noto Sans KR',sans-serif;
  font-size:15px;font-weight:500;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  touch-action:manipulation;
}
.btn-whisper-transcribe:disabled{opacity:.35;cursor:not-allowed;}
.btn-whisper-transcribe.loading{animation:rpulse 1.5s ease-in-out infinite;}
.whisper-status{font-size:12px;color:var(--text-dim);text-align:center;margin-top:6px;min-height:16px;}
.whisper-key-saved{font-size:11px;color:var(--green);margin-top:4px;}

/* ── STT 실패 말주머니 ── */
.stt-bubble{
  display:none;
  position:relative;
  margin-top:10px;
  background:#1e2127;
  border:1.5px solid var(--amber-border);
