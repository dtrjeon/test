document.getElementById('clova-file-input').addEventListener('change', function(){
  const file = this.files[0];
  if(!file) return;
  // txt 파일 여부 확인 (MIME 타입 또는 확장자)
  const isTxt = file.type === 'text/plain' || file.name.toLowerCase().endsWith('.txt') || file.name.toLowerCase().endsWith('.text') || file.type === '';
  if(!isTxt){
    showBanner('⚠ txt 파일만 불러올 수 있습니다.<br>클로바노트 앱에서 <strong>공유 → txt 저장</strong> 후 선택해 주세요.', 'err');
    this.value = ''; return;
  }
  // 안드로이드 content:// URI는 size가 0으로 잡힐 수 있어 0은 허용
  if(file.size > 5 * 1024 * 1024){
    showBanner('⚠ 파일이 너무 큽니다 (5MB 이하만 가능)', 'err'); return;
  }
  const reader = new FileReader();
  function applyText(text) {
    if(!text || !text.trim()){
      showBanner('⚠ 파일 내용이 비어있습니다.', 'err'); return;
    }
    document.getElementById('clova-paste').value = text;
    const tag = document.getElementById('file-name-tag');
    tag.textContent = '📄 ' + (file.name || '선택된 파일');
    tag.style.display = 'block';
    showBanner('✓ 파일을 불러왔습니다. 아래 <strong>적용하기</strong> 버튼을 누르세요.', 'ok');
    setStatus('파일 불러오기 완료 — 적용 버튼을 누르세요');
  }
  reader.onload = function(e){
    const text = e.target.result;
    // 깨진 문자 포함 시 EUC-KR 재시도
    if(text.includes('�')){
      const r2 = new FileReader();
      r2.onload = ev => applyText(ev.target.result);
      r2.onerror = () => showBanner('⚠ 파일 인코딩 오류. UTF-8 또는 EUC-KR txt 파일을 사용해 주세요.', 'err');
      r2.readAsText(file, 'EUC-KR');
    } else {
      applyText(text);
    }
  };
  reader.onerror = function(){
    showBanner('⚠ 파일을 읽을 수 없습니다. txt 파일인지 확인해 주세요.', 'err');
  };
  reader.readAsText(file, 'UTF-8');
  this.value = '';
});

/* ════════════ 클로바노트 텍스트 적용 ════════════ */
document.getElementById('btn-clova-apply').addEventListener('click', function(){
  const pasted = document.getElementById('clova-paste').value.trim();
  if(!pasted){ showBanner('⚠ 내용이 없습니다. 파일을 불러오거나 텍스트를 붙여넣으세요.', 'warn'); return; }
  // 1) BOM 제거 및 줄 분리
  let lines = pasted.replace(/^\uFEFF/, '').split(/\r?\n/);

  // 2) 앞부분 정리: 첫 3줄 제거 후 빈줄 건너뛰고 첫 본문 찾기
  lines = lines.slice(3); // 앞 3줄 삭제
  // 빈줄 이후 첫 내용부터 시작 (참석자 N 같은 헤더 포함 가능)
  let startIdx = 0;
  for(let i = 0; i < lines.length; i++){
    if(lines[i].trim() === ''){ startIdx = i + 1; } else { break; }
  }
  lines = lines.slice(startIdx);

  // 3) 참석자 N 형태 헤더 줄 제거
  lines = lines.filter(l => !/^참석자\s*\d+\s*$/.test(l.trim()));

  // 4) 마지막 영문(URL, 영문만으로 구성된 줄) 제거
  while(lines.length > 0){
    const last = lines[lines.length - 1].trim();
    if(last === '' || /^[a-zA-Z0-9\s./:_\-@]+$/.test(last)){
      lines.pop();
    } else { break; }
  }

  // 5) 타임스탬프·화자 라벨 제거 후 합치기
  let cleaned = lines.join(' ')
    .replace(/\[\d{2}:\d{2}(:\d{2})?\]/g, '')
    .replace(/^.+?:\s*/gm, '')
    .replace(/\n+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  cleaned = numToKor(cleaned);
  recordedText = cleaned;
  transcript = cleaned;
  updateRecordedPreview();
  hideBanner();
  showBanner('✓ 텍스트가 적용되었습니다. 비교 분석 버튼을 누르세요.', 'ok');
  setStatus('클로바노트 텍스트 적용 완료 ✓');
});

