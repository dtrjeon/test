function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ── 숫자 → 한글 변환 ──
// 고유어 변환 규칙: 숫자+단위 조합별 특수 처리
const NATIVE_NUM = {
  '1':'한','2':'두','3':'세','4':'네','5':'다섯',
  '6':'여섯','7':'일곱','8':'여덟','9':'아홉','10':'열',
  '20':'스물','30':'서른','40':'마흔','50':'쉰',
  '60':'예순','70':'일흔','80':'여든','90':'아흔'
};
// 고유어를 사용하는 단위
const NATIVE_UNITS = ['번','개','명','살','가지','마리','그루','채','권','잔','병','벌','켤레','쌍'];

function numToKor(str){
  const units0 = ['','일','이','삼','사','오','육','칠','팔','구'];
  const units1 = ['','십','백','천'];
  const units2 = ['','만','억','조'];

  function convertGroup(n){
    // n: 0~9999 정수
    if(n === 0) return '';
    let result = '';
    const digits = [Math.floor(n/1000)%10, Math.floor(n/100)%10, Math.floor(n/10)%10, n%10];
    const pos    = [3, 2, 1, 0];
    digits.forEach((d, i) => {
      if(d === 0) return;
      // 일십/일백/일천 → 십/백/천 (1은 생략)
      result += (d === 1 && pos[i] > 0 ? '' : units0[d]) + units1[pos[i]];
    });
    return result;
  }

  // 숫자+단위 조합: 고유어 단위면 고유어 숫자로, 아니면 한자어로
  str = str.replace(/(\d+)([가-힣]+)/g, function(_, num, unit){
    const baseUnit = unit.charAt(0);
    // 만/억/조는 한자어+붙여쓰기
    if('만억조'.includes(baseUnit)){
      const n = parseInt(num, 10);
      return _numKor(n) + unit;
    }
    // 고유어 단위면 고유어 숫자+붙여쓰기
    if(NATIVE_UNITS.some(u => unit.startsWith(u))){
      const n = String(parseInt(num, 10));
      const kor = NATIVE_NUM[n];
      if(kor) return kor + ' ' + unit;
      // 11~99 범위 고유어 없으면 한자어+공백
      return _numKor(parseInt(num,10)) + ' ' + unit;
    }
    // 그 외 한자어+공백
    return _numKor(parseInt(num,10)) + ' ' + unit;
  });
  // 남은 단독 숫자
  return str.replace(/\d+/g, function(match){
    let num = parseInt(match, 10);
    if(num === 0) return '영';
    let result = '';
    const groupNames = ['', '만', '억', '조'];
    const groups = [];
    while(num > 0){ groups.unshift(num % 10000); num = Math.floor(num / 10000); }
    groups.forEach((g, i) => {
      const offset = groups.length - 1 - i;
      if(g === 0) return;
      result += convertGroup(g) + groupNames[offset];
    });
    return result || '영';
  });
}

function _numKor(num){
  if(num === 0) return '영';
  const units0 = ['','일','이','삼','사','오','육','칠','팔','구'];
  const units1 = ['','십','백','천'];
  function cg(n){
    if(n===0) return '';
    let r='';
    const d=[(n/1000|0)%10,(n/100|0)%10,(n/10|0)%10,n%10];
    const p=[3,2,1,0];
    d.forEach((v,i)=>{ if(!v)return; r+=(v===1&&p[i]>0?'':units0[v])+units1[p[i]]; });
    return r;
  }
  let r='', n=num;
  const gn=['','만','억','조'], gs=[];
  while(n>0){gs.unshift(n%10000);n=Math.floor(n/10000);}
  gs.forEach((g,i)=>{ const o=gs.length-1-i; if(!g)return; r+=cg(g)+gn[o]; });
  return r;
}

// 구두점 제거 공통 함수
function stripPunct(s){
  return s.replace(/[.,?!，。？！“”‘’「」『』()（）[\]]/g,'')
          .replace(/\s+/g,' ').trim().toLowerCase();
}

function splitSentences(raw){
  // 문장 부호 뒤 공백/줄끝을 기준으로 문장 분리
  const sents = raw
    .replace(/([.?!。？！])([\s])/g, '$1\n')
    .split('\n')
    .map(s => s.trim())
    .filter(Boolean);
  const wordList=[], wordSentIdx=[];
  sents.forEach((s,si)=>{
    stripPunct(s).split(' ').filter(Boolean)
      .forEach(w=>{ wordList.push(w); wordSentIdx.push(si); });
  });
  return { wordList, wordSentIdx };
}

function normWords(s){
  return stripPunct(s).split(' ').filter(Boolean);
}

function lcsOps(a,b){
  const m=a.length, n=b.length;
  const dp=Array.from({length:m+1},()=>new Array(n+1).fill(0));
  for(let i=1;i<=m;i++) for(let j=1;j<=n;j++)
    dp[i][j]=a[i-1]===b[j-1]?dp[i-1][j-1]+1:Math.max(dp[i-1][j],dp[i][j-1]);
  let i=m,j=n; const ops=[];
  while(i>0||j>0){
    if(i>0&&j>0&&a[i-1]===b[j-1]){ ops.unshift({t:'ok',aw:a[i-1],bw:b[j-1]}); i--;j--; }
    else if(j>0&&(i===0||dp[i][j-1]>=dp[i-1][j])){ ops.unshift({t:'extra',bw:b[j-1]}); j--; }
    else{ ops.unshift({t:'miss',aw:a[i-1]}); i--; }
  }
  return ops;
}

function mergeOps(ops){
  const merged=[];
  for(let k=0;k<ops.length;){
    if(ops[k].t==='miss'&&ops[k+1]&&ops[k+1].t==='extra'){
      merged.push({t:'sub',aw:ops[k].aw,bw:ops[k+1].bw}); k+=2;
    } else { merged.push(ops[k]); k++; }
  }
  return merged;
}

function compare(){
  // stopRec() 전에 먼저 현재 텍스트 캡처 (mediaRecorder.onstop 은 비동기이므로)
  if(isRecording){
    if(transcript.trim()) recordedText = transcript; // 비동기 완료 전 미리 저장
    stopRec();
  }
  const origRaw = document.getElementById('original').value.trim();
  // recordedText 와 transcript 둘 다 확인
  if(!recordedText.trim() && transcript.trim()) recordedText = transcript;
  const recRaw  = recordedText.trim();
  if(!origRaw){ alert('원본 텍스트를 선택하거나 입력해 주세요.'); return; }
  if(!recRaw) { alert('녹음 텍스트가 없습니다.\n마이크 녹음 또는 클로바노트 파일/붙여넣기를 먼저 해주세요.'); return; }

  const {wordList:origWords, wordSentIdx} = splitSentences(origRaw);
  const recWords = normWords(recRaw);
  const ops = mergeOps(lcsOps(origWords, recWords));

  let correct=0, missing=0, extra=0, sub=0;
  ops.forEach(o=>{ if(o.t==='ok')correct++; else if(o.t==='miss')missing++; else if(o.t==='extra')extra++; else sub++; });
  const accuracy = Math.round(correct/Math.max(origWords.length,1)*100);

  const BR='<br style="display:block;margin:5px 0 1px;">';
  let origPtr=0, lastSI=-1, lH='', rH='';
  ops.forEach(o=>{
    if(o.t!=='extra'){
      const si = wordSentIdx[origPtr]!==undefined ? wordSentIdx[origPtr] : lastSI;
      if(si!==lastSI && lastSI!==-1){ lH+=BR; rH+=BR; }
      lastSI=si; origPtr++;
    }
    if     (o.t==='ok')   { lH+=`<span class="w w-ok">${esc(o.aw)}</span>`;   rH+=`<span class="w w-ok">${esc(o.bw)}</span>`; }
    else if(o.t==='miss') { lH+=`<span class="w w-miss">${esc(o.aw)}</span>`; rH+=`<span class="w w-ph">—</span>`; }
    else if(o.t==='extra'){ lH+=`<span class="w w-ph">—</span>`;              rH+=`<span class="w w-extra">${esc(o.bw)}</span>`; }
    else                  { lH+=`<span class="w w-sub">${esc(o.aw)}</span>`;  rH+=`<span class="w w-sub">${esc(o.bw)}</span>`; }
  });

  let grade,sc,gd;
  if     (accuracy>=95){grade='완벽';sc='#4ade80';gd='거의 완벽하게 일치합니다!';}
  else if(accuracy>=80){grade='우수';sc='#60a5fa';gd='대부분 일치합니다.';}
  else if(accuracy>=60){grade='보통';sc='#fbbf24';gd='절반 이상 일치합니다.';}
  else                 {grade='미흡';sc='#f87171';gd='많은 부분이 다릅니다.';}
  const bc=accuracy>=95?'#4ade80':accuracy>=80?'#60a5fa':accuracy>=60?'#fbbf24':'#f87171';
  const chInfo=selected.length>0
    ? selected.map(id=>{const c=CHAPTERS.find(x=>x.id===id);return c.num+' '+c.title;}).join(' + ')
    : '직접 입력';

  document.getElementById('result-area').innerHTML=`
    <div class="result-panel">
      <div class="score-bar">
        <div class="score-top">
          <div class="score-badge" style="color:${sc};">${accuracy}%</div>
          <div class="score-info">
            <div class="score-chapter">${chInfo}</div>
            <div class="score-grade" style="color:${sc};">${grade}</div>
            <div class="score-desc">${gd}</div>
          </div>
        </div>
        <div class="stats-row">
          <div class="stat-chip" style="background:var(--green-bg);border-color:var(--green-border);color:var(--green);"><span class="stat-num">${correct}</span><span class="stat-lbl">일치</span></div>
          <div class="stat-chip" style="background:var(--red-bg);border-color:var(--red-border);color:var(--red);"><span class="stat-num">${missing}</span><span class="stat-lbl">누락</span></div>
          <div class="stat-chip" style="background:var(--amber-bg);border-color:var(--amber-border);color:var(--amber);"><span class="stat-num">${extra}</span><span class="stat-lbl">추가</span></div>
          <div class="stat-chip" style="background:var(--blue-bg);border-color:var(--blue-border);color:var(--blue);"><span class="stat-num">${sub}</span><span class="stat-lbl">대체</span></div>
        </div>
      </div>
      <!-- 프린트 전용 머리글 -->
      <div class="print-header" id="print-header">
        <div class="print-header-title" id="print-title">음성 텍스트 비교 결과</div>
        <div class="print-header-meta" id="print-meta"></div>
        <div class="print-legend">
          <div class="print-legend-item"><span style="text-decoration:line-through;">취소선</span> = 누락</div>
          <div class="print-legend-item"><span style="background:#f0f0f0;border:1px solid #999;padding:0 4px;border-radius:3px;">회색박스</span> = 추가</div>
          <div class="print-legend-item"><span style="background:#e8e8e8;border:1px solid #999;padding:0 4px;border-radius:3px;font-style:italic;">이탤릭</span> = 대체</div>
        </div>
      </div>
      <div class="diff-section">
        <div class="diff-block">
          <div class="diff-block-title">원본 텍스트</div>
          <div class="diff-content">${lH||'<span style="color:var(--text-dim);">내용 없음</span>'}</div>
        </div>
        <div class="diff-block">
          <div class="diff-block-title">녹음 텍스트</div>
          <div class="diff-content">${rH||'<span style="color:var(--text-dim);">내용 없음</span>'}</div>
        </div>
      </div>
      <div class="progress-wrap">
        <div class="progress-label"><span>일치율</span><span>${accuracy}%</span></div>
        <div class="progress-track"><div class="progress-fill" style="width:${accuracy}%;background:${bc};"></div></div>
      </div>
    </div>`;

  // 프린트 / 미리보기 버튼 활성화
  const pb = document.getElementById('btn-print');
  pb.disabled = false; pb.classList.add('ready');
  const pvb = document.getElementById('btn-preview');
  pvb.disabled = false; pvb.classList.add('ready');

  // 미리보기용 문장별 데이터 저장
  lastPreviewData = {
    lH, rH, accuracy, grade, sc, gd,
    correct, missing, extra, sub, bc, chInfo,
    origWords, recWords, ops, wordSentIdx
  };

  setTimeout(()=>document.getElementById('result-area').scrollIntoView({behavior:'smooth',block:'start'}),150);

  // ── 로그 저장 (ops 포함) ──
  saveLog(chInfo, accuracy, grade, ops, origWords);
}

