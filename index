/* ════════════ 오류 분석 ════════════ */
function openAnalysisModal(){
  const logs = getLogs();
  // 이름 목록
  const names = [...new Set(logs.map(l=>l.name).filter(Boolean))].sort();
  const chapters = [...new Set(logs.map(l=>l.chapter).filter(Boolean))].sort();
  const nSel = document.getElementById('analysis-name');
  const cSel = document.getElementById('analysis-chapter');
  nSel.innerHTML = '<option value="">— 이름 선택 —</option>' +
    names.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('');
  cSel.innerHTML = '<option value="">— 챕터 선택 —</option>' +
    chapters.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');
  document.getElementById('analysis-result').innerHTML =
    '<div class="log-empty">이름과 챕터를 선택 후 분석 버튼을 누르세요</div>';
  document.getElementById('analysis-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function runAnalysis(){
  const name    = document.getElementById('analysis-name').value;
  const chapter = document.getElementById('analysis-chapter').value;
  if(!name || !chapter){
    document.getElementById('analysis-result').innerHTML =
      '<div class="log-empty" style="color:var(--amber);">⚠ 이름과 챕터를 모두 선택하세요</div>';
    return;
  }
  const logs = getLogs().filter(l => l.name === name && l.chapter === chapter);
  if(!logs.length){
    document.getElementById('analysis-result').innerHTML =
      '<div class="log-empty">해당 조건의 기록이 없습니다</div>';
    return;
  }

  // ── 회차별 요약 ──
  const sessionHtml = logs.map((l,i) => {
    const gc = gradeColor(l.grade);
    const best = l.accuracy === Math.max(...logs.map(x=>x.accuracy));
    return `<span class="session-chip${best?' best':''}"
      style="${best?'':'border-color:'+gc.color+';background:rgba(0,0,0,.1);color:'+gc.color+''}">
      ${i+1}회 ${l.time.split(' ')[1]||''} ${l.accuracy}%</span>`;
  }).join('');

  // ── 원문 단어 목록 ──
  // 가장 긴 origWords 를 기준으로 사용 (없으면 챕터 텍스트에서 추출)
  let baseWords = [];
  for(const l of logs){ if(l.origWords && l.origWords.length > baseWords.length) baseWords = l.origWords; }
  if(!baseWords.length){
    const ch = CHAPTERS.find(c => chapter.includes(c.title) || chapter.includes(c.num));
    if(ch) baseWords = normWords(ch.text);
  }

  // ── 단어별 오류 누적 카운트 ──
  // errMap: { word → { miss:n, sub:n, total:n, subWords:[...] } }
  const errMap = {};
  logs.forEach(l => {
    (l.errWords||[]).forEach(e => {
      const w = e.aw || e.bw;
      if(!w) return;
      if(!errMap[w]) errMap[w] = { miss:0, sub:0, total:0, subWords:[] };
      if(e.t === 'miss'){ errMap[w].miss++; errMap[w].total++; }
      else if(e.t === 'sub'){
        errMap[w].sub++; errMap[w].total++;
        if(e.bw && !errMap[w].subWords.includes(e.bw)) errMap[w].subWords.push(e.bw);
      }
    });
  });

  const totalSessions = logs.length;

  // ── 원문 히트맵 ──
  const heatHtml = baseWords.map(w => {
    const e = errMap[w];
    const cnt = e ? e.total : 0;
    const pct = Math.round(cnt / totalSessions * 100);
    let cls = 'hw-ok';
    if(cnt >= totalSessions)       cls = 'hw-err3';  // 매 회차 틀림
    else if(cnt >= totalSessions * 0.5) cls = 'hw-err2'; // 절반 이상
    else if(cnt > 0)               cls = 'hw-err1';  // 1회 이상
    const tip = cnt > 0 ? `${cnt}/${totalSessions}회 오류(${pct}%)` : '';
    return `<span class="hw ${cls}" ${tip?`data-tip="${tip}"`:''}>${esc(w)}</span>`;
  }).join(' ');

  // ── 상위 오류 단어 ──
  const errList = Object.entries(errMap)
    .sort((a,b) => b[1].total - a[1].total)
    .slice(0, 10);
  const maxCnt = errList[0] ? errList[0][1].total : 1;

  const errListHtml = errList.length ? errList.map(([w, e]) => {
    const pct = Math.round(e.total / totalSessions * 100);
    const barW = Math.round(e.total / maxCnt * 100);
    const subTxt = e.subWords.length ? `→ "${e.subWords.slice(0,3).join('", "')}"` : '';
    return `<div class="err-word-row">
      <span class="err-word-orig">${esc(w)}</span>
      <div class="err-word-bar-wrap"><div class="err-word-bar" style="width:${barW}%"></div></div>
      <span class="err-word-cnt">${e.total}회 (${pct}%)</span>
      ${subTxt ? `<span class="err-word-sub">${esc(subTxt)}</span>` : ''}
    </div>`;
  }).join('') : '<div style="font-size:13px;color:var(--green);">✓ 오류 단어가 없습니다</div>';

  // ── 평균 일치율 ──
  const avgAcc = Math.round(logs.reduce((s,l)=>s+l.accuracy,0) / logs.length);
  const best   = Math.max(...logs.map(l=>l.accuracy));

  document.getElementById('analysis-result').innerHTML = `
    <div style="font-size:13px;color:var(--text-muted);margin-bottom:10px;">
      <strong style="color:var(--text);">${esc(name)}</strong> ·
      <strong style="color:var(--accent);">${esc(chapter)}</strong> ·
      총 <strong style="color:var(--text);">${totalSessions}회</strong> 점검 |
      평균 <strong style="color:var(--blue);">${avgAcc}%</strong> |
      최고 <strong style="color:var(--green);">${best}%</strong>
    </div>

    <div class="analysis-section-title">🕐 회차별 결과</div>
    <div class="analysis-sessions">${sessionHtml}</div>

    <div class="analysis-section-title">🔴 자주 틀리는 단어 (상위 10)</div>
    <div class="err-word-list">${errListHtml}</div>

    <div class="analysis-section-title">📄 원문 오류 히트맵
      <span style="font-weight:400;text-transform:none;font-size:10px;margin-left:6px;">
        🟡 1회+ &nbsp; 🔴 절반이상 &nbsp; ■ 매회 오류
      </span>
    </div>
    <div class="heatmap-wrap">${heatHtml}</div>
  `;
}

