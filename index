    return;
  }

  // ── STT 모드: STT 먼저 시작, onstart 후 MediaRecorder 시작 ──
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){ showBanner('⚠ Chrome 브라우저를 사용해 주세요.', 'err'); return; }
  recognition = new SR();
  recognition.lang = 'ko-KR';
  recognition.continuous = false;
  recognition.interimResults = true;
  recognition.maxAlternatives = 1;
  let base = transcript;
  let mediaStarted = false;

  recognition.onstart = () => {
    isRecording = true;
    document.getElementById('btn-rec').classList.add('recording');
    document.getElementById('rec-label').textContent = '녹음 중지 (탭하여 중지)';
    setStatus('● 녹음 중... 말씀하세요');

    // STT 가 마이크를 잡은 후 MediaRecorder 시작 (한 번만)
    if(!mediaStarted){
      mediaStarted = true;
      _startMediaRecorder();
    }
  };

  recognition.onresult = (e) => {
    let interim='', final=base;
    for(let i=e.resultIndex; i<e.results.length; i++){
      if(e.results[i].isFinal) final += e.results[i][0].transcript;
      else interim += e.results[i][0].transcript;
    }
    transcript = numToKor(final);
    recordedText = numToKor(transcript + interim);
    updateRecordedPreview();
    // STT 모드일 때 실시간 텍스트 표시
    if(recMode === 'stt'){
      const el = document.getElementById('stt-live-text');
      if(el) el.textContent = transcript + (interim ? ' ...' + interim : '');
    }
  };

  recognition.onerror = (e) => {
    if(e.error==='no-speech' || e.error==='audio-capture') return;
    if(e.error==='not-allowed'){ showBanner('⚠ 마이크 권한이 차단되었습니다.','err'); stopRec(); return; }
    setStatus('인식 오류: '+e.error+' — 재시도 중');
  };

  recognition.onend = () => {
    if(isRecording){ base=transcript; try{ recognition.start(); }catch(e){} }
  };

  try { recognition.start(); } catch(e){ setStatus('녹음 시작 실패: '+e.message); }
}

function _startMediaRecorder(){
  const _candidates = [
    { mime: 'audio/mp4',              ext: 'm4a'  },
    { mime: 'audio/webm;codecs=opus', ext: 'webm' },
    { mime: 'audio/webm',             ext: 'webm' },
    { mime: 'audio/ogg;codecs=opus',  ext: 'ogg'  },
  ];
  const _supported = _candidates.find(c => {
    try { return MediaRecorder.isTypeSupported(c.mime); } catch(e){ return false; }
  });
  navigator.mediaDevices.getUserMedia({audio:true}).then(stream => {
    let _options = {};
    if(_supported){ _options={mimeType:_supported.mime}; audioMime=_supported.mime; audioExt=_supported.ext; }
    try {
      mediaRecorder = new MediaRecorder(stream, _options);
    } catch(e) {
      mediaRecorder = new MediaRecorder(stream);
      audioMime=''; audioExt='webm';
    }
    mediaRecorder.ondataavailable = e => { if(e.data.size>0) audioChunks.push(e.data); };
    mediaRecorder.onstop = () => {
      const _type = audioMime || 'audio/webm';
      audioBlob = new Blob(audioChunks, {type:_type});
      stream.getTracks().forEach(t=>t.stop());
      const btn = document.getElementById('btn-save-audio');
      btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg> 음성 저장 (.'+audioExt+')';
      btn.disabled=false; btn.classList.add('ready');
      // Whisper 모드: 음성 저장 완료 → Whisper 추출 버튼 안내
      if(recMode==='api') setStatus('음성 녹음 완료 ✓ — ⑤ 텍스트 추출(Whisper) 버튼을 누르세요');
    };
    mediaRecorder.start();
  }).catch(()=>{
    if(recMode==='api') setStatus('⚠ 마이크 스트림 오류 — 권한을 확인해 주세요');
    else setStatus('● 녹음 중... (음성파일 저장 불가, 텍스트만 저장됩니다)');
  });
}

function stopRec(){
  isRecording = false;
  if(recognition){ recognition.onend=null; try{ recognition.stop(); }catch(e){} }
  if(mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
  document.getElementById('btn-rec').classList.remove('recording');
  document.getElementById('rec-label').textContent = '③ 녹음 시작';
  if(transcript.trim()) recordedText = transcript;
  updateRecordedPreview();
  if(transcript.trim()){
    const btn = document.getElementById('btn-save-audio');
    btn.disabled = false; btn.classList.add('ready');
  }
  if(recMode === 'api'){
    setStatus('녹음 완료 ✓ — ⑤ 텍스트 추출(Whisper) 버튼을 누르세요');
  } else {
    setStatus('녹음 완료 ✓ — ④ 음성저장 버튼을 누르세요');
  }
}

