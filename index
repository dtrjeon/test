/* ── 서버 연결 표시등 제어 ── */
function setDot(state){
  const dot   = document.getElementById('server-dot');
  const label = document.getElementById('server-dot-label');
  if(!dot) return;
  dot.className = 'server-dot';
  if(state === 'off'){
    dot.style.display = 'none';
    label.textContent = '';
    return;
  }
  dot.style.display = 'inline-block';
  if(state === 'checking'){
    dot.classList.add('checking');
    label.textContent = '확인 중';
  } else if(state === 'connected'){
    dot.classList.add('connected');
    label.textContent = '서버 연결됨';
  } else if(state === 'disconnected'){
    dot.classList.add('disconnected');
    label.textContent = '연결 안됨';
  }
}

/* ── Google Apps Script 전송 ── */
async function sendToServer(entry){
  if(!serverUrl){ showServerStatus('err','⚠ 서버 URL을 먼저 설정해주세요'); setDot('disconnected'); return false; }
  showServerStatus('sending','📡 구글 시트로 전송 중...');
  setDot('checking');
  try{
    await fetch(serverUrl, {
      method : 'POST',
      mode   : 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body   : JSON.stringify(entry)
    });
    showServerStatus('ok', '✓ 구글 시트 전송 완료 ✦ 로컬 백업도 저장됨');
    setDot('connected');
    return true;
  } catch(e){
    showServerStatus('err', '⚠ 전송 실패 (네트워크 오류): ' + e.message);
    setDot('disconnected');
    return false;
  }
}

/* ── 연결 테스트 ── */
async function testServerConnection(){
  if(!serverUrl){ showServerStatus('err','⚠ URL을 먼저 입력하고 저장하세요'); return; }
  showServerStatus('sending','🔍 연결 테스트 중...');
  setDot('checking');
  try{
    const res = await fetch(serverUrl, { method:'GET', mode:'cors' });
    const txt = await res.text();
    if(txt.includes('정상 동작')){
      showServerStatus('ok','✓ 연결 성공 — 구글 시트 수신 서버 응답 확인');
      setDot('connected');
    } else {
      showServerStatus('ok','✓ 서버 응답 확인 (내용: ' + txt.slice(0,40) + ')');
      setDot('connected');
    }
  } catch(e){
    showServerStatus('err','⚠ 연결 실패: ' + e.message + ' (URL 확인 필요)');
    setDot('disconnected');
  }
}

/* ── 로그 저장 (모드 분기) ── */
async function saveLog(chInfo, accuracy, grade, ops, origWords){
  const name = document.getElementById('user-name').value.trim() || '(미입력)';
  const now = new Date();
  const kst = new Date(now.getTime() + 9*60*60*1000);
  const dateStr = kst.getUTCFullYear()+'.'
    +String(kst.getUTCMonth()+1).padStart(2,'0')+'.'
    +String(kst.getUTCDate()).padStart(2,'0')+' '
    +String(kst.getUTCHours()).padStart(2,'0')+':'
    +String(kst.getUTCMinutes()).padStart(2,'0');

  // ops 에서 단어별 오류 횟수만 경량 저장 { word, type('miss'|'sub'|'extra'), bw? }
  const errWords = (ops||[])
    .filter(o => o.t !== 'ok')
    .map(o => ({ t: o.t, aw: o.aw||'', bw: o.bw||'' }));

  const entry = { time: dateStr, name, chapter: chInfo, accuracy, grade,
                  origWords: origWords||[], errWords };

  // 항상 로컬 저장
  const logs = getLogs(); logs.push(entry); saveLogs(logs);

  if(logMode === 'server'){
    // 서버엔 경량 버전 전송 (origWords 제외)
    const serverEntry = { time:dateStr, name, chapter:chInfo, accuracy, grade };
    await sendToServer(serverEntry);
  } else {
    showServerStatus('ok', '✓ 테스트 기록 저장 완료');
    document.getElementById('server-status').style.display = 'block';
  }
}

/* ── 로그 테이블 렌더 ── */
function gradeColor(g){
  if(g==='완벽') return {bg:'rgba(74,222,128,.18)',color:'#4ade80'};
  if(g==='우수') return {bg:'rgba(96,165,250,.18)',color:'#60a5fa'};
  if(g==='보통') return {bg:'rgba(251,191,36,.18)',color:'#fbbf24'};
  return {bg:'rgba(248,113,113,.18)',color:'#f87171'};
}

function renderLogTable(){
  const logs = getLogs();
  const wrap = document.getElementById('log-table-wrap');
  const modeTag = logMode === 'server'
    ? '<span style="font-size:11px;color:var(--clova);margin-left:6px;">🌐 서버+로컬</span>'
    : '<span style="font-size:11px;color:var(--text-dim);margin-left:6px;">🧪 로컬 저장</span>';
  if(!logs.length){
    wrap.innerHTML=`<div class="log-empty">기록이 없습니다${modeTag}</div>`;
    return;
  }
  const rows = logs.slice().reverse().map((l,i)=>{
    const gc = gradeColor(l.grade);
    const origIdx = logs.length - 1 - i;   // 원래 배열 인덱스 (최신=끝)
    const canReplay = !!(l.errWords && l.origWords && l.origWords.length);
    const replayBtn = canReplay
      ? `<button class="btn-log-replay" onclick="replayLog(${origIdx})">📄 미리보기</button>`
      : `<span style="font-size:10px;color:var(--text-dim);">—</span>`;
    return `<tr>
      <td>${logs.length-i}</td>
      <td style="white-space:nowrap;">${l.time}</td>
      <td>${l.name}</td>
      <td style="font-size:11px;">${l.chapter}</td>
      <td><span class="log-badge" style="background:${gc.bg};color:${gc.color};">${l.accuracy}% ${l.grade}</span></td>
      <td>${replayBtn}</td>
    </tr>`;
  }).join('');
  wrap.innerHTML = `
    <div style="padding:8px 0 4px;font-size:11px;color:var(--text-dim);">
      총 ${logs.length}건 ${modeTag}
    </div>
    <table class="log-table">
      <thead><tr><th>#</th><th>시간</th><th>이름</th><th>점검 챕터</th><th>결과</th><th>미리보기</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
}

/* ── CSV 내보내기 ── */
function exportCSV(){
  const logs = getLogs();
  if(!logs.length){ alert('내보낼 기록이 없습니다.'); return; }
  const bom = '\uFEFF';
  const header = '번호,시간,이름,점검챕터,일치율(%),등급\n';
  const rows = logs.map((l,i)=>
    `${i+1},"${l.time}","${l.name}","${l.chapter}",${l.accuracy},"${l.grade}"`
  ).join('\n');
  const blob = new Blob([bom+header+rows], {type:'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const now = new Date();
  const ts = now.getFullYear()+''+(now.getMonth()+1).toString().padStart(2,'0')+now.getDate().toString().padStart(2,'0');
  a.href=url; a.download='점검기록_'+ts+'.csv';
  document.body.appendChild(a); a.click();
  document.body.removeChild(a); URL.revokeObjectURL(url);
}

/* ════════════ 로그 미리보기 (누적 오류 포함) ════════════ */

/**
 * 로그 idx 회차를 미리보기 모달로 표시
 * - 원본(origWords) + 그 회차 errWords로 ops 재구성
 * - 동일 이름+챕터의 전체 기록을 분석해 반복 오류 단어 표시
 */
function replayLog(idx){
  const logs = getLogs();
  const entry = logs[idx];
  if(!entry){ alert('기록을 찾을 수 없습니다.'); return; }

  // ── 1. ops 재구성 (origWords + errWords → lcsOps 재실행) ──
  const origWords = entry.origWords || [];
  if(!origWords.length){ alert('이 기록에는 원본 단어 데이터가 없습니다.\n(이전 버전 기록은 미리보기 불가)'); return; }

  // errWords({t,aw,bw})로 녹음 텍스트(recWords)를 역산
  // miss → 원본에 있고 녹음에 없음, sub → 원본 aw 대신 bw, extra → 녹음에만 있음
  // 가장 정확한 방법: origWords 순서대로 traversal하여 recWords 재구성
  const recWords = [];
  let origPtr = 0;
  const errWords = entry.errWords || [];

  // errWords를 원본 단어 순서 기반으로 정렬·매핑
  // miss/sub/extra를 origWords 위치에 맞춰 recWords 생성
  // origWords를 순회하며 errMap 조회
  const errByOrig = {};   // origWord(index) → {t, bw}
  let origIdx2 = 0;
  errWords.forEach(e => {
    if(e.t === 'miss'){
      // miss: origWords에서 찾기
      const pos = origWords.indexOf(e.aw, origIdx2);
      if(pos !== -1){ errByOrig[pos] = e; origIdx2 = pos + 1; }
    } else if(e.t === 'sub'){
      const pos = origWords.indexOf(e.aw, origIdx2);
      if(pos !== -1){ errByOrig[pos] = e; origIdx2 = pos + 1; }
    }
  });

  // recWords 재구성: origWords 순서 + extra 삽입
  // extra는 위치 정보가 없으므로 끝에 추가 (정확한 위치 복원 불가 — 미리보기용으로 충분)
  origWords.forEach((w, i) => {
    const e = errByOrig[i];
    if(!e){
      recWords.push(w);         // ok
    } else if(e.t === 'miss'){
      // 누락 — recWords에 포함 안 됨
    } else if(e.t === 'sub'){
      recWords.push(e.bw);      // 대체
    }
  });
  errWords.filter(e => e.t === 'extra').forEach(e => recWords.push(e.bw));

  const ops = mergeOps(lcsOps(origWords, recWords));

  // ── 2. 동일 이름+챕터 전체 기록에서 누적 오류 단어 집계 ──
  const sameGroup = logs.filter(l =>
    l.name === entry.name &&
    l.chapter === entry.chapter &&
    l.errWords && l.errWords.length
  );
  const totalSessions = sameGroup.length;

  // word → 오류 발생 횟수
  const wordErrCount = {};
  sameGroup.forEach(l => {
    const seen = new Set();
    (l.errWords || []).forEach(e => {
      const w = (e.t === 'extra') ? null : e.aw;
      if(w && !seen.has(w)){ seen.add(w); wordErrCount[w] = (wordErrCount[w]||0) + 1; }
    });
  });

  // ── 3. 미리보기 HTML 생성 ──
  const { wordList: baseOrigWords, wordSentIdx } = splitSentences(origWords.join(' '));
  const html = buildReplayPreviewHTML({
    entry, ops, origWords, wordSentIdx,
    wordErrCount, totalSessions, sessionNo: idx + 1, allSessionCount: logs.length
  });

  // 로그 모달 닫기 → 미리보기 모달 열기
  document.getElementById('log-modal').classList.remove('open');
  document.getElementById('preview-a4-content').innerHTML = html;
  document.getElementById('preview-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

/**
 * 로그 기반 미리보기 HTML 생성
 * - 현재 회차의 원본/녹음 비교 (문장별)
 * - 누적 오류 단어 히트맵 섹션 추가
 */
function buildReplayPreviewHTML({ entry, ops, origWords, wordSentIdx, wordErrCount, totalSessions, sessionNo, allSessionCount }){
  const dateStr = entry.time || '';
  const chInfo  = entry.chapter || '';
  const accuracy= entry.accuracy || 0;
  const grade   = entry.grade || '';
  const name    = entry.name || '';

  // 등급 색상
  const gc = {완벽:'#4ade80',우수:'#60a5fa',보통:'#fbbf24',미흡:'#f87171'}[grade] || '#aaa';

  // ── 문장별로 ops 분리 (buildPreviewHTML 과 동일 로직) ──
  const sentGroups = [];
  let curSent = -1, origPtr2 = 0;
  ops.forEach(op => {
    let si = curSent;
    if(op.t !== 'extra'){
      si = wordSentIdx[origPtr2] !== undefined ? wordSentIdx[origPtr2] : curSent;
      origPtr2++;
    }
    if(si !== curSent || sentGroups.length === 0){
      if(op.t === 'extra' && sentGroups.length === 0){ sentGroups.push({si:0, ops:[]}); }
      else if(si !== curSent){ curSent = si; sentGroups.push({si, ops:[]}); }
    }
    if(sentGroups.length === 0) sentGroups.push({si:0, ops:[]});
    sentGroups[sentGroups.length-1].ops.push(op);
  });

  function wordSpan(op, side){
    const w = side==='l' ? op.aw : op.bw;
    // 반복오류 여부: 원본 단어가 2회 이상 오류
    const isRepeat = op.t !== 'ok' && side==='l' && op.aw && (wordErrCount[op.aw]||0) >= 2;
    if(op.t==='ok'){
      return `<span class="pw pw-ok">${esc(w)}</span>`;
    } else if(op.t==='miss'){
      return side==='l'
        ? `<span class="pw pw-miss${isRepeat?' pw-repeat':''}" title="${wordErrCount[op.aw]||0}회 반복 오류">${esc(op.aw)}</span>`
        : `<span class="pw pw-ph">—</span>`;
    } else if(op.t==='extra'){
      return side==='l'
        ? `<span class="pw pw-ph">—</span>`
        : `<span class="pw pw-extra">${esc(op.bw)}</span>`;
    } else {
      if(side==='l'){
        return `<span class="pw pw-sub${isRepeat?' pw-repeat':''}" title="${wordErrCount[op.aw]||0}회 반복 오류">${esc(op.aw)}</span>`;
      } else {
        return `<span class="pw pw-sub">${esc(op.bw)}</span>`;
      }
    }
  }

  let rowsHTML = '';
  sentGroups.forEach((sg, idx) => {
    const lWords = sg.ops.map(o => wordSpan(o,'l')).join(' ');
    const rWords = sg.ops.map(o => wordSpan(o,'r')).join(' ');
    const prob   = sg.ops.some(o => o.t !== 'ok');
    const numColor = prob ? '#cc0000' : '#999';
    const lBg = prob ? 'background:#fff5f5;' : '';
    const rBg = prob ? 'background:#f5fff8;' : '';
    rowsHTML += `
      <div class="pv-row">
        <div class="pv-cell pv-orig" style="${lBg}">
          <span class="pv-num" style="color:${numColor};">${idx+1}</span>
          <div class="pv-words">${lWords}</div>
        </div>
        <div class="pv-cell pv-rec" style="${rBg}">
          <span class="pv-num" style="color:${numColor};">${idx+1}</span>
          <div class="pv-words">${rWords}</div>
        </div>
      </div>`;
  });

  // ── 누적 오류 단어 섹션 ──
  let accHTML = '';
  if(totalSessions >= 2){
    const sorted = Object.entries(wordErrCount)
      .filter(([,cnt]) => cnt >= 1)
      .sort((a,b) => b[1]-a[1]);

    if(sorted.length){
      const chips = sorted.map(([w, cnt]) => {
        const pct  = Math.round(cnt / totalSessions * 100);
        const cls  = cnt >= totalSessions ? 'freq3'
                   : cnt >= Math.ceil(totalSessions/2) ? 'freq2' : 'freq1';
        return `<span class="pv-acc-chip ${cls}">${esc(w)}<span class="pv-acc-cnt">${cnt}/${totalSessions}</span></span>`;
      }).join('');

      accHTML = `
        <div class="pv-acc-section">
          <div class="pv-acc-title">
            🔴 반복 오류 단어 분석 — ${esc(name)} · ${esc(chInfo)} · 총 ${totalSessions}회 점검
          </div>
          <div style="font-size:8pt;color:#888;margin-bottom:4px;">
            ■ 매회 오류 &nbsp; <span style="color:#e06020;">■</span> 절반 이상 &nbsp; <span style="color:#c0a000;">■</span> 1회 이상 &nbsp;&nbsp;
            원본 열에서 굵은 빨강 = 2회 이상 반복 오류 단어
          </div>
          <div class="pv-acc-grid">${chips}</div>
        </div>`;
    }
  }

  // ── 통계 ──
  let correct=0, missing=0, extra=0, sub=0;
  ops.forEach(o=>{ if(o.t==='ok')correct++; else if(o.t==='miss')missing++; else if(o.t==='extra')extra++; else sub++; });

  return `
    <div style="background:#ffffff !important;color:#000 !important;color-scheme:light !important;min-height:100%;">
    <div class="pv-header">
      <div class="pv-title">전도폭발훈련 전문 구두점검</div>
      <div class="pv-subtitle">${esc(chInfo)}</div>
      <div class="pv-meta">
        점검자: <strong>${esc(name)}</strong> &nbsp;|&nbsp;
        시각: ${esc(dateStr)} &nbsp;|&nbsp;
        회차: ${allSessionCount}건 중 기록 &nbsp;|&nbsp;
        일치율: <strong style="color:${gc};">${accuracy}% (${esc(grade)})</strong> &nbsp;|&nbsp;
        일치 ${correct} / 누락 ${missing} / 추가 ${extra} / 대체 ${sub}
      </div>
      <div class="pv-legend">
        <div class="pv-legend-item"><span class="pv-leg-sample pw-miss">단어</span> 누락(빨강)</div>
        <div class="pv-legend-item"><span class="pv-leg-sample pw-extra">단어</span> 추가(파랑)</div>
        <div class="pv-legend-item"><span class="pv-leg-sample pw-sub">단어</span> 대체·오타(보라)</div>
        <div class="pv-legend-item"><span class="pv-leg-sample pw-repeat">단어</span> 반복오류(굵은빨강)</div>
      </div>
    </div>
    <div class="pv-progress-wrap">
      <div class="pv-progress-label"><span>일치율</span><span>${accuracy}%</span></div>
      <div class="pv-progress-track">
        <div class="pv-progress-fill" style="width:${accuracy}%;background:${gc};"></div>
      </div>
    </div>
    ${accHTML}
    <div class="pv-table" style="margin-top:4mm;">
      <div class="pv-table-header">
        <div class="pv-th">원본 텍스트</div>
        <div class="pv-th">녹음 텍스트 (이 회차)</div>
      </div>
      ${rowsHTML}
    </div>
    </div>`;
}

